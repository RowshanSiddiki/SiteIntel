# Copy this file to .env and replace the placeholders with local values.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=siteintel_user
MYSQL_PASSWORD=replace-with-your-local-mysql-password

# Local HTTP development: false. Set true when serving over HTTPS.
SESSION_COOKIE_SECURE=false

# Document Assistant (optional). Without an LLM, answers show cited passages.
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=60
# DOCUMENT_MAX_BYTES=26214400

# Optional handwriting-capable OCR (Azure AI Document Intelligence Read model).
# Documents stay local unless both values are configured.
# HANDWRITING_OCR_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# HANDWRITING_OCR_KEY=
# HANDWRITING_OCR_TIMEOUT_SECONDS=60
