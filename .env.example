# Copy this file to .env and replace the placeholders with local values.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=siteintel_user
MYSQL_PASSWORD=replace-with-your-local-mysql-password

# Local HTTP development: false. Set true when serving over HTTPS.
SESSION_COOKIE_SECURE=false
